<style>
:root{color-scheme:dark;--bg:#0b0d10;--panel:#12161b;--panel2:#171d24;--line:#26313c;--text:#e6edf4;--muted:#9aa7b5;--accent:#3ddc84;--accentText:#04140a;--blue:#8bb8ff;--warn:#ffd166;--shadow:0 14px 40px #0005}
:root[data-theme=light]{color-scheme:light;--bg:#f3f6f8;--panel:#fff;--panel2:#eaf0f4;--line:#d5dee6;--text:#17212b;--muted:#5b6976;--accent:#159b52;--accentText:#fff;--blue:#245ea8;--warn:#8b5a00;--shadow:0 14px 40px #2334  }
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.7 system-ui,-apple-system,"Segoe UI",sans-serif}a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}button,input{font:inherit}button{color:var(--text);background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:9px 13px;cursor:pointer}button:hover{border-color:var(--accent)}button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:12px;padding:10px max(18px,calc((100vw - 1240px)/2));background:color-mix(in srgb,var(--panel) 92%,transparent);border-bottom:1px solid var(--line);backdrop-filter:blur(16px)}.logo{font-size:18px;font-weight:850;letter-spacing:1px;color:var(--text)}.logo span{color:var(--accent)}.topbar .grow{flex:1}.topbar .tag{font-size:11px;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:3px 9px}.primary{background:var(--accent);border-color:var(--accent);color:var(--accentText);font-weight:700}.hero{max-width:1240px;margin:0 auto;padding:56px 24px 30px}.eyebrow{color:var(--accent);font-weight:800;text-transform:uppercase;font-size:11px;letter-spacing:.16em}.hero h1{font-size:clamp(36px,6vw,64px);line-height:1.05;letter-spacing:-.045em;margin:12px 0}.hero p{max-width:760px;color:var(--muted);font-size:18px;margin:0}.heroActions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.layout{max-width:1240px;margin:0 auto;padding:16px 24px 56px;display:grid;grid-template-columns:250px minmax(0,1fr);gap:30px}.sidebar{position:sticky;top:78px;align-self:start;max-height:calc(100dvh - 96px);overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px}.sidebar h2{margin:0 0 9px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}.sidebar a{display:block;color:var(--muted);padding:7px 9px;border-radius:7px;font-size:13px}.sidebar a:hover,.sidebar a.active{background:var(--panel2);color:var(--text);text-decoration:none}.sidebar a.active{box-shadow:inset 3px 0 var(--accent)}main{min-width:0}.introGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:28px}.infoCard,.docSection,.callout{background:var(--panel);border:1px solid var(--line);border-radius:14px}.infoCard{padding:16px}.infoCard .big{font-size:22px;font-weight:800;color:var(--accent)}.infoCard h3{font-size:14px;margin:3px 0}.infoCard p{font-size:12px;color:var(--muted);margin:0}.docSection{padding:24px;margin:0 0 16px;scroll-margin-top:90px}.sectionHead{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px}.sectionNo{display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:10px;background:color-mix(in srgb,var(--accent) 14%,var(--panel));color:var(--accent);font-weight:800}.docSection h2{margin:0;font-size:23px;line-height:1.3;letter-spacing:-.02em}.docSection h3{font-size:16px;margin:22px 0 6px}.docSection p{color:var(--muted);margin:9px 0}.docSection ul,.docSection ol{padding-left:22px;color:var(--muted)}.docSection li{margin:5px 0}.docSection strong{color:var(--text)}.codeWrap{position:relative;margin:12px 0 16px}.codeWrap pre{margin:0;padding:16px 52px 16px 16px;background:#080b0e;color:#e1edf8;border:1px solid #27313c;border-radius:10px;overflow:auto;white-space:pre;font:13px/1.7 ui-monospace,SFMono-Regular,Consolas,monospace;tab-size:4}.copySnippet{position:absolute;right:8px;top:8px;background:#18222c;color:#d9e6f2;border:1px solid #354555;padding:5px 8px;font-size:11px}.inlineCode{background:var(--panel2);border:1px solid var(--line);border-radius:5px;padding:1px 5px;color:var(--text);font:12px ui-monospace,monospace}.callout{padding:14px 16px;margin:14px 0;border-left:3px solid var(--accent)}.callout.warn{border-left-color:var(--warn)}.callout p{margin:0}.tableWrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px;margin:14px 0}table{width:100%;border-collapse:collapse;min-width:520px;font-size:13px}th,td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:top}th{background:var(--panel2);color:var(--text)}td{color:var(--muted)}tr:last-child td{border-bottom:0}.twoCol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.miniCard{border:1px solid var(--line);border-radius:10px;padding:14px;background:var(--panel2)}.miniCard h3{margin:0 0 4px}.miniCard p{font-size:13px;margin:0}.searchBox{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text);margin-bottom:10px}.mobileToc{display:none}.progress{height:3px;position:fixed;z-index:30;top:0;left:0;width:0;background:var(--accent)}.footer{padding:30px 20px;text-align:center;color:var(--muted);border-top:1px solid var(--line);font-size:12px}.backTop{position:fixed;right:18px;bottom:18px;border-radius:50%;width:46px;height:46px;background:var(--accent);color:var(--accentText);border:0;box-shadow:var(--shadow);font-size:20px;display:none}.backTop.show{display:block}.kbd{display:inline-block;padding:2px 6px;border:1px solid var(--line);border-radius:5px;background:var(--panel2);font:11px ui-monospace,monospace;color:var(--text)}
@media(prefers-color-scheme:light){:root:not([data-theme]){color-scheme:light;--bg:#f3f6f8;--panel:#fff;--panel2:#eaf0f4;--line:#d5dee6;--text:#17212b;--muted:#5b6976;--accent:#159b52;--accentText:#fff;--blue:#245ea8;--warn:#8b5a00;--shadow:0 14px 40px #2334}}
@media(max-width:850px){.layout{grid-template-columns:1fr;padding:12px 16px 44px}.sidebar{display:none}.mobileToc{display:block;max-width:1240px;margin:0 auto;padding:0 16px}.mobileToc details{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:10px 14px}.mobileToc summary{font-weight:700;cursor:pointer}.mobileToc nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3px;margin-top:8px}.mobileToc a{padding:7px;color:var(--muted);font-size:12px}.hero{padding:38px 18px 18px}.introGrid{grid-template-columns:1fr 1fr}.topbar{padding:9px 14px}.hero p{font-size:16px}}
@media(max-width:520px){body{font-size:14px}.topbar{gap:8px}.topbar .tag{display:none}.topbar button{padding:8px 10px;font-size:12px}.hero{padding-top:30px}.hero h1{font-size:42px}.hero p{font-size:15px}.introGrid{grid-template-columns:1fr 1fr;gap:8px}.infoCard{padding:12px}.infoCard .big{font-size:19px}.docSection{padding:17px 14px;border-radius:12px}.docSection h2{font-size:20px}.sectionNo{width:30px;height:30px}.twoCol{grid-template-columns:1fr}.codeWrap pre{font-size:12px;padding:14px 12px;white-space:pre;overflow-x:auto}.copySnippet{position:static;margin:6px 0 0}.mobileToc nav{grid-template-columns:1fr 1fr}.tableWrap{margin-left:-2px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>
<body>
<div class="progress" id="progress"></div>
<header class="topbar" id="top"><a class="logo" href="index.html">VY<span>RA</span></a><span class="tag">VYRA Code Studio · Guide</span><span class="grow"></span><button id="themeBtn" type="button">Theme: Dark</button><button class="primary" onclick="location.href='index.html'">Open IDE ↗</button></header>
<section class="hero"><div class="eyebrow">Learn by building</div><h1>Welcome to <span style="color:var(--accent)">VYRA.</span></h1><p>A practical guide to the VYRA language, browser IDE, compiler, keyboard shortcuts, and current limitations. Start with one small program, run it, then explore one feature at a time.</p><div class="heroActions"><button class="primary" onclick="location.href='index.html'">Start coding</button><a href="#quickstart"><button type="button">Quick start ↓</button></a></div></section>
<div class="mobileToc"><details><summary>Guide contents · tap to open</summary><input id="guideSearchMobile" class="searchBox" type="search" placeholder="Filter sections…" aria-label="Filter guide sections"><nav id="mobileNav"></nav></details></div>
<div class="layout">
<aside class="sidebar"><h2>On this page</h2><input id="guideSearch" class="searchBox" type="search" placeholder="Filter sections…" aria-label="Filter guide sections"><nav id="sideNav"></nav></aside>
<main>
<div class="introGrid"><div class="infoCard"><div class="big">01</div><h3>Write</h3><p>Use the editor with indentation and suggestions.</p></div><div class="infoCard"><div class="big">02</div><h3>Run</h3><p>Execute supported VYRA code in the browser.</p></div><div class="infoCard"><div class="big">03</div><h3>Build</h3><p>Compile VYRA into portable C source.</p></div></div>
<section class="docSection" id="quickstart"><div class="sectionHead"><span class="sectionNo">01</span><div><h2>Quick start: your first program</h2><p>Follow these steps in the IDE.</p></div></div><ol><li>Open <strong>VYRA Code Studio</strong>. VYRA is selected by default and its demo is loaded automatically.</li><li>Click inside the editor and replace the demo with the sample below.</li><li>Press the green <strong>Run</strong> button or <span class="kbd">Ctrl</span> + <span class="kbd">Enter</span>.</li><li>Read the result in the Output panel. On a phone, the workspace switches to Output after running; tap <strong>Editor</strong> to return.</li></ol><div class="codeWrap"><pre>name = "VYRA learner"
print("Hello,", name)
print("I just ran my first program!")</pre><button class="copySnippet" type="button">Copy example</button></div><div class="callout"><p><strong>Tip:</strong> Use <strong>Load demo</strong> to load the built-in example. <strong>Reset demo</strong> also replaces the current editor contents, so confirm before discarding a draft.</p></div></section>
<section class="docSection" id="interface"><div class="sectionHead"><span class="sectionNo">02</span><div><h2>Know your workspace</h2><p>What each control does.</p></div></div><div class="twoCol"><div class="miniCard"><h3>Run</h3><p>Compiles and executes the active VYRA source with the browser runtime. Python and C modes show a runtime notice; they are editor modes only.</p></div><div class="miniCard"><h3>Compile to C</h3><p>Translates the current VYRA program into C code and opens the <code class="inlineCode">output.c</code> tab.</p></div><div class="miniCard"><h3>Language selector</h3><p>Choose VYRA, Python, or C. Each mode has its own demo, autocomplete list, draft, and file extension.</p></div><div class="miniCard"><h3>Open / Download file</h3><p>Open supported <code class="inlineCode">.vy</code>, <code class="inlineCode">.py</code>, <code class="inlineCode">.c</code>, and <code class="inlineCode">.h</code> files. Download saves the active editor source.</p></div><div class="miniCard"><h3>Copy code / Find</h3><p>Copy the editor contents or find and replace text in the current file. Find is also available with <span class="kbd">Ctrl</span> + <span class="kbd">F</span>.</p></div><div class="miniCard"><h3>Theme</h3><p>Cycle through automatic, dark, and light themes. Your preference is stored in this browser when storage is available.</p></div><div class="miniCard"><h3>Autosave / Restore draft</h3><p>Edits are stored locally in your browser. After a refresh, use <strong>Restore draft</strong> to recover a saved draft; the first-run screen still opens on the VYRA demo.</p></div><div class="miniCard"><h3>Project backup</h3><p>Export all language drafts and IDE preferences to a JSON file, then import that backup on this browser or another device.</p></div><div class="miniCard"><h3>Output tabs</h3><p><strong>Output</strong> shows the result or compiler messages. <strong>output.c</strong> shows the generated C source for the latest successful compile.</p></div><div class="miniCard"><h3>Editor display</h3><p>Use A− / A+ to change editor text size and Wrap to control long-line display. These preferences are remembered locally.</p></div></div></section>
<section class="docSection" id="mobile"><div class="sectionHead"><span class="sectionNo">03</span><div><h2>Using VYRA on a phone</h2><p>The mobile workspace uses a compact bottom dock and focused editor/output views.</p></div></div><ul><li>Use the bottom dock: <strong>Editor</strong> returns to code, <strong>Run</strong> executes VYRA, <strong>Output</strong> opens results, and <strong>Guide</strong> opens this tutorial.</li><li>Swipe the top toolbar horizontally to reach less-used actions such as Open file, Find, Theme, and Download.</li><li>After pressing Run, the IDE switches to Output. Tap Editor in the bottom dock to continue writing.</li><li>Use <strong>A−</strong> and <strong>A+</strong> in the toolbar to adjust editor text size. Use <strong>Wrap</strong> to switch between wrapped lines and horizontal scrolling.</li><li>The editor uses larger default text on narrow screens, safe-area spacing, and large touch targets. Rotate the phone for longer programs.</li><li>The language selector, cursor position, and document count remain available in the Editor view.</li><li>Use the quick-insert strip beneath the language selector to add common statements without typing every character on a phone.</li><li>Use Export backup before changing devices; Import backup restores your saved language drafts and editor preferences.</li><li>On supported browsers, use Install app to add VYRA to your home screen. Open the site once while online before relying on its offline app shell.</li></ul><div class="callout"><p><strong>Phone tip:</strong> The dock stays reachable near the bottom of the screen. On phones with a home indicator, its spacing follows the device safe area. External keyboards can still use the shortcuts listed below.</p></div></section>
<section class="docSection" id="syntax"><div class="sectionHead"><span class="sectionNo">04</span><div><h2>VYRA language basics</h2><p>VYRA uses indentation to define blocks and is intentionally smaller than Python.</p></div></div><h3>Variables and values</h3><p>Assign a number or a quoted string to a variable. The compiler infers the type on first assignment. A variable cannot switch between numeric and string values later.</p><div class="codeWrap"><pre>name = "Asha"
level = 1
score = 92.5
print("Name:", name)
print("Score:", score)
level = level + 1</pre><button class="copySnippet" type="button">Copy example</button></div><h3>Output with print()</h3><p><code class="inlineCode">print()</code> accepts comma-separated string literals, string variables, and numeric expressions. Values are separated by spaces.</p><div class="codeWrap"><pre>language = "VYRA"
print("Welcome to", language)
print("Seven times six:", 7 * 6)</pre><button class="copySnippet" type="button">Copy example</button></div><h3>Numbers and math</h3><div class="tableWrap"><table><thead><tr><th>Operator / function</th><th>Purpose</th><th>Example</th></tr></thead><tbody><tr><td><code>+ - * /</code></td><td>Arithmetic</td><td><code>8 + 2 * 3</code></td></tr><tr><td><code>sqrt(x)</code></td><td>Square root</td><td><code>sqrt(81)</code></td></tr><tr><td><code>pow(x, y)</code></td><td>Power</td><td><code>pow(2, 5)</code></td></tr><tr><td><code>abs(x)</code></td><td>Absolute value</td><td><code>abs(-9)</code></td></tr><tr><td><code>sin cos tan</code></td><td>Trigonometry in radians</td><td><code>sin(0)</code></td></tr><tr><td><code>floor ceil</code></td><td>Round down / up</td><td><code>ceil(4.2)</code></td></tr><tr><td><code>PI</code></td><td>Pi constant</td><td><code>print(PI)</code></td></tr></tbody></table></div><div class="callout warn"><p><strong>Not supported:</strong> <code>**</code>, <code>%</code>, string joining with <code>+</code>, and arbitrary function calls. Use <code>pow(a, b)</code> instead of <code>a ** b</code>.</p></div></section>
<section class="docSection" id="conditions"><div class="sectionHead"><span class="sectionNo">05</span><div><h2>Conditions and loops</h2><p>Every block begins with a colon and an indented body.</p></div></div><h3>if / elif / else</h3><div class="codeWrap"><pre>marks = 86
if marks >= 90:
    print("Grade A")
elif marks >= 80:
    print("Grade B")
else:
    print("Keep practicing")</pre><button class="copySnippet" type="button">Copy example</button></div><p>Comparisons: <code class="inlineCode">==</code>, <code class="inlineCode">!=</code>, <code class="inlineCode">&gt;</code>, <code class="inlineCode">&lt;</code>, <code class="inlineCode">&gt;=</code>, <code class="inlineCode">&lt;=</code>. Logical operators: <code class="inlineCode">and</code>, <code class="inlineCode">or</code>, and <code class="inlineCode">not</code>.</p><h3>while</h3><div class="codeWrap"><pre>count = 1
while count <= 5:
    print("Count:", count)
    count = count + 1
print("Finished")</pre><button class="copySnippet" type="button">Copy example</button></div><h3>break, continue, and pass</h3><p><code class="inlineCode">break</code> exits the innermost loop, <code class="inlineCode">continue</code> moves to its next iteration, and <code class="inlineCode">pass</code> is a placeholder statement.</p></section>
<section class="docSection" id="comments"><div class="sectionHead"><span class="sectionNo">06</span><div><h2>Comments and indentation</h2><p>Readable formatting helps the compiler understand your blocks.</p></div></div><div class="codeWrap"><pre># This is a comment
points = 10 # trailing comments are allowed
if points > 0:
    print("Positive")</pre><button class="copySnippet" type="button">Copy example</button></div><ul><li>Use four spaces per indentation level.</li><li>Press <strong>Tab</strong> in the editor to insert four spaces.</li><li>Press <strong>Enter</strong> after a colon to continue the indentation level.</li><li><strong>Backspace</strong> at the start of an indented line removes one four-space level.</li><li><span class="kbd">Ctrl</span> + <span class="kbd">/</span> toggles comments on selected lines.</li></ul></section>
<section class="docSection" id="autocomplete"><div class="sectionHead"><span class="sectionNo">07</span><div><h2>Autocomplete, find, and editing tools</h2><p>Small editor features that speed up everyday work.</p></div></div><ul><li>Start typing a supported keyword or built-in to open suggestions.</li><li>Use <strong>↑</strong> and <strong>↓</strong> to select a suggestion, <strong>Enter</strong> to accept it, or <strong>Esc</strong> to close the list.</li><li>Use <span class="kbd">Ctrl</span> + <span class="kbd">F</span> to open Find. Enter a search term, then use Next, Replace, or All.</li><li>Use <strong>Tab</strong> / <strong>Shift+Tab</strong> to indent or outdent selected lines.</li><li>Drag a supported source file onto the editor to open it.</li></ul></section>
<section class="docSection" id="display"><div class="sectionHead"><span class="sectionNo">07A</span><div><h2>Editor display settings</h2><p>Adjust the editor to suit your screen and reading preferences.</p></div></div><div class="twoCol"><div class="miniCard"><h3>Text size</h3><p>Use <strong>A−</strong> and <strong>A+</strong> in the top toolbar to make code smaller or larger. The setting is remembered in this browser and stays between 12 and 20 pixels.</p></div><div class="miniCard"><h3>Word wrap</h3><p><strong>Wrap: On</strong> breaks long code lines to fit the editor width. <strong>Wrap: Off</strong> keeps each source line on one visual line and allows horizontal scrolling. The preference is saved locally. Wrapped visual rows still belong to one source line.</p></div><div class="miniCard"><h3>Mobile bottom dock</h3><p>The dock offers Editor, Run, Output, and Guide shortcuts. It remains at the bottom of the phone screen and respects device safe-area spacing.</p></div><div class="miniCard"><h3>Draft safety</h3><p>Language drafts and display settings are stored separately. If browser storage is disabled or cleared, local recovery may not be available; download important work regularly.</p></div></div></section>
<section class="docSection" id="backup"><div class="sectionHead"><span class="sectionNo">07B</span><div><h2>Project backup and quick insert</h2><p>Protect your work and make coding easier on a touchscreen.</p></div></div><div class="twoCol"><div class="miniCard"><h3>Export backup</h3><p>Choose <strong>Export backup</strong> to download a JSON file containing the saved VYRA, Python, and C drafts, their filenames, the active language, theme, and editor display preferences. Keep this file somewhere safe.</p></div><div class="miniCard"><h3>Import backup</h3><p>Choose <strong>Import backup</strong> and select a JSON backup created by VYRA Code Studio. The IDE checks its format and file size before restoring supported drafts. Importing a backup can replace drafts with the same language, so export your current work first if you need a second copy.</p></div><div class="miniCard"><h3>Phone quick insert</h3><p>On a narrow screen, a horizontal strip appears below the language selector. Tap a template such as <code class="inlineCode">print()</code>, <code class="inlineCode">if</code>, <code class="inlineCode">while</code>, or <code class="inlineCode">pass</code> to insert it at the cursor. Templates change with the selected language.</p></div><div class="miniCard"><h3>Template placeholders</h3><p>After inserting a block template, replace placeholder text such as <code class="inlineCode">condition</code> or <code class="inlineCode">item</code> with your own variable or expression before running it.</p></div></div><div class="callout warn"><p><strong>Backup reminder:</strong> Autosave is stored in this browser only. Export a backup before clearing browser data, changing devices, or testing a major update. A backup is not uploaded to a server.</p></div></section>
<section class="docSection" id="install"><div class="sectionHead"><span class="sectionNo">07C</span><div><h2>Install VYRA and work offline</h2><p>On supported browsers, VYRA can be added to your home screen and its app shell can be cached for offline use.</p></div></div><div class="twoCol"><div class="miniCard"><h3>Android / desktop Chromium</h3><p>Open the secure HTTPS VYRA site. When the browser reports that installation is available, tap <strong>Install app</strong> in the IDE. You can also use the browser menu and choose <strong>Install app</strong> or <strong>Add to Home screen</strong>.</p></div><div class="miniCard"><h3>iPhone / iPad</h3><p>Open VYRA in Safari, tap <strong>Share</strong>, then choose <strong>Add to Home Screen</strong>. iOS does not expose the same install prompt button as Chromium, so use the Share menu.</p></div></div><div class="callout"><p><strong>Offline behavior:</strong> After the site has loaded once while online and the service worker has finished installing, the IDE and guide shell can reopen offline. This does not add Python or C execution engines, and browser storage remains local to that device.</p></div></section>
<section class="docSection" id="compile"><div class="sectionHead"><span class="sectionNo">08</span><div><h2>Compile VYRA to C</h2><p>The IDE has a browser compiler and a separate native compiler.</p></div></div><ol><li>Select <strong>VYRA</strong>.</li><li>Click <strong>Compile to C</strong>. The generated source appears in the <code class="inlineCode">output.c</code> tab.</li><li>Click <strong>Download output.c</strong>.</li><li>With GCC installed, compile and run it in a terminal:</li></ol><div class="codeWrap"><pre>gcc output.c -o main -lm
./main</pre><button class="copySnippet" type="button">Copy commands</button></div><p>The <code class="inlineCode">-lm</code> flag links the C math library. The browser's Run button does not invoke GCC; it executes the compiler's generated JavaScript representation.</p><div class="callout"><p><strong>Native workflow:</strong> The project ZIP includes <code class="inlineCode">vyra.c</code>, <code class="inlineCode">demo.vy</code>, a Makefile, and smoke tests. Run <code class="inlineCode">make test</code> to test the native compiler.</p></div></section>
<section class="docSection" id="python-c"><div class="sectionHead"><span class="sectionNo">09</span><div><h2>Python and C modes</h2><p>These modes are for editing, demos, and autocomplete.</p></div></div><p>The current web IDE includes Python and C language modes so you can edit and save files with the correct extensions. The built-in Run button does <strong>not</strong> execute Python or C code. For Python, use a Python interpreter; for C, use GCC or Clang. Selecting these modes and clicking Run displays a clear runtime-unavailable message instead of sending their code to the VYRA compiler.</p></section>
<section class="docSection" id="shortcuts"><div class="sectionHead"><span class="sectionNo">10</span><div><h2>Keyboard shortcuts</h2><p>Shortcuts use Ctrl on Windows/Linux and Command on macOS for browser-based editing.</p></div></div><div class="tableWrap"><table><thead><tr><th>Shortcut</th><th>Action</th></tr></thead><tbody><tr><td><kbd>Ctrl</kbd> + <kbd>Enter</kbd></td><td>Run active mode (VYRA executes; Python/C show a runtime notice).</td></tr><tr><td><kbd>Ctrl</kbd> + <kbd>S</kbd></td><td>Download current source file.</td></tr><tr><td><kbd>Ctrl</kbd> + <kbd>F</kbd></td><td>Open Find and Replace.</td></tr><tr><td><kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>L</kbd></td><td>Load the selected language demo.</td></tr><tr><td><kbd>Ctrl</kbd> + <kbd>/</kbd></td><td>Toggle line comments.</td></tr><tr><td><kbd>Tab</kbd> / <kbd>Shift+Tab</kbd></td><td>Indent / outdent code.</td></tr><tr><td><kbd>Enter</kbd></td><td>Continue indentation; add indentation after a VYRA/Python colon or C opening brace.</td></tr><tr><td><kbd>Esc</kbd></td><td>Close autocomplete or Find.</td></tr></tbody></table></div></section>
<section class="docSection" id="errors"><div class="sectionHead"><span class="sectionNo">11</span><div><h2>Common errors and fixes</h2><p>Start with the line number in the compiler message.</p></div></div><div class="tableWrap"><table><thead><tr><th>Message / symptom</th><th>Why it happens</th><th>What to do</th></tr></thead><tbody><tr><td>Expected an indented block</td><td>An if/while line is not followed by an indented statement.</td><td>Add a body with four spaces of indentation.</td></tr><tr><td>Inconsistent indentation</td><td>Indent levels do not match the open block.</td><td>Use consistent four-space indentation.</td></tr><tr><td>Undefined variable</td><td>A variable is read before its first assignment.</td><td>Assign it before using it.</td></tr><tr><td>Unknown function</td><td>The function name is not one of the supported built-ins.</td><td>Use a supported math function or rewrite the expression.</td></tr><tr><td>Strings can't be used in math</td><td>String concatenation and string arithmetic are not supported.</td><td>Pass multiple values to <code>print()</code> as separate arguments.</td></tr><tr><td>Reserved word</td><td>The name conflicts with a language or C keyword.</td><td>Rename the variable, for example <code>total_count</code>.</td></tr><tr><td>Runtime stopped</td><td>The browser execution guard stopped a very long or oversized-output program.</td><td>Check for a loop that never ends or prints too much.</td></tr></tbody></table></div></section>
<section class="docSection" id="internals"><div class="sectionHead"><span class="sectionNo">12</span><div><h2>How the compiler is organized</h2><p>A quick map of the source code included in the project.</p></div></div><div class="twoCol"><div class="miniCard"><h3><code>vyra.c</code></h3><p>The native VYRA-to-C compiler, used by the command-line build and native test suite.</p></div><div class="miniCard"><h3><code>VYRA.compile()</code></h3><p>The JavaScript compiler embedded in <code>index.html</code>, used by the browser IDE.</p></div><div class="miniCard"><h3>Expression translator</h3><p>Checks numeric expressions, variables, supported operators, constants, and math functions.</p></div><div class="miniCard"><h3>Block stack</h3><p>Tracks indentation levels and turns if/elif/else/while blocks into brace-delimited C and JavaScript.</p></div><div class="miniCard"><h3>Output builder</h3><p>Emits C declarations and statements, plus a JavaScript program for browser execution.</p></div><div class="miniCard"><h3>Editor layer</h3><p>Handles autocomplete, drafts, line numbers, file operations, Find/Replace, and responsive workspace views.</p></div></div><div class="callout warn"><p><strong>Security note:</strong> VYRA is an educational compiler playground, not a secure sandbox for hostile code. The browser runtime has time and output guards, but do not use it to run code you do not understand or treat generated C as audited software.</p></div></section>
<section class="docSection" id="limits"><div class="sectionHead"><span class="sectionNo">13</span><div><h2>Current language limits</h2><p>These are deliberate limits of the current VYRA v0.2 compiler, not errors in your editor.</p></div></div><ul><li>No user-defined functions, parameters, or return values. The optional <code class="inlineCode">fn main():</code> line is only an accepted top-level marker.</li><li>No <code class="inlineCode">for</code> loops, arrays, lists, dictionaries, or classes.</li><li>No interactive input or file/network APIs within VYRA programs.</li><li>No string concatenation or general string operations.</li><li>No <code class="inlineCode">%</code> remainder or <code class="inlineCode">**</code> exponent operator; use <code class="inlineCode">pow()</code>.</li><li>Python/C browser execution is not bundled in the IDE.</li></ul></section>
<section class="docSection" id="practice"><div class="sectionHead"><span class="sectionNo">14</span><div><h2>Practice ideas</h2><p>Try these in order. Keep each program small and test it often.</p></div></div><div class="twoCol"><div class="miniCard"><h3>Beginner · Personal intro</h3><p>Store your name, age, and favorite language; print them with labels.</p></div><div class="miniCard"><h3>Beginner · Grade checker</h3><p>Use if/elif/else to turn a marks variable into a grade.</p></div><div class="miniCard"><h3>Intermediate · Countdown</h3><p>Use a while loop to count down from 10 to 1 and print a finish message.</p></div><div class="miniCard"><h3>Intermediate · Sum 1–50</h3><p>Use an accumulator variable and a loop to calculate the total.</p></div></div><div class="heroActions"><button class="primary" onclick="location.href='index.html'">Back to VYRA IDE ↗</button><a href="#top"><button type="button">Back to top ↑</button></a></div></section>
</main>
</div>
<footer class="footer">VYRA Beta · Guide for the currently implemented browser compiler and editor.</footer>
<button class="backTop" id="backTop" aria-label="Back to top">↑</button>
<script>
if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost')) window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));
const sections=[...document.querySelectorAll('.docSection')];
const navItems=sections.map(section=>({id:section.id,label:section.querySelector('h2').textContent}));
function makeNav(target){target.replaceChildren();navItems.forEach(item=>{const a=document.createElement('a');a.href='#'+item.id;a.textContent=item.label;a.dataset.section=item.id;target.appendChild(a);});}
makeNav(document.getElementById('sideNav'));makeNav(document.getElementById('mobileNav'));
const links=[...document.querySelectorAll('.sidebar a,.mobileToc a')];
function activeSection(){let current=sections[0]?.id;for(const section of sections){if(section.getBoundingClientRect().top<150)current=section.id;}links.forEach(a=>a.classList.toggle('active',a.dataset.section===current));}
window.addEventListener('scroll',()=>{const max=document.documentElement.scrollHeight-innerHeight;document.getElementById('progress').style.width=(max>0?scrollY/max*100:0)+'%';document.getElementById('backTop').classList.toggle('show',scrollY>500);activeSection();},{passive:true});
activeSection();
document.querySelectorAll('.copySnippet').forEach(button=>button.addEventListener('click',async()=>{const code=button.previousElementSibling.textContent;try{await navigator.clipboard.writeText(code);button.textContent='Copied';}catch(_){button.textContent='Select code to copy';}setTimeout(()=>button.textContent='Copy example',1500);}));
function filterGuide(q){q=q.toLowerCase();links.forEach(a=>{const hit=a.textContent.toLowerCase().includes(q);a.style.display=hit?'block':'none';});}document.getElementById('guideSearch').addEventListener('input',e=>filterGuide(e.target.value));document.getElementById('guideSearchMobile').addEventListener('input',e=>filterGuide(e.target.value));
document.getElementById('backTop').onclick=()=>window.scrollTo({top:0,behavior:'smooth'});
let saved='auto';try{saved=localStorage.getItem('vyra-ide-theme-v1')||'auto';}catch(_){}function setGuideTheme(value){if(value==='auto')document.documentElement.removeAttribute('data-theme');else document.documentElement.dataset.theme=value;document.getElementById('themeBtn').textContent='Theme: '+value[0].toUpperCase()+value.slice(1);try{localStorage.setItem('vyra-ide-theme-v1',value);}catch(_){}}
let theme=['auto','dark','light'].includes(saved)?saved:'dark';setGuideTheme(theme);document.getElementById('themeBtn').onclick=()=>{theme=theme==='auto'?'dark':theme==='dark'?'light':'auto';setGuideTheme(theme);};
</script>
</body>
</html>
